---
import '@fontsource-variable/manrope';
import '@styles/global.css';
import Header from '@components/Header.astro';
import SeoTags from '@components/SeoTags.astro';
import Footer from '@components/Footer.astro';
import MobileCallBar from '@components/MobileCallBar.astro';
import IpBar from '@components/IpBar.astro';
import AdVisitBeacon from '@components/AdVisitBeacon.astro';
import GoogleAdsTag from '@components/GoogleAdsTag.astro';
import CookieConsent from '@components/CookieConsent.astro';
import { site } from '@data/site';
import { buildTitle, canonicalUrl, localBusinessSchema, websiteSchema } from '@utils/seo';

interface Props {
  title: string;
  description: string;
  /** true ise başlığa marka eklenmez */
  rawTitle?: boolean;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Sayfa altındaki arama ifadeleri bloğu için bölge adı. Boş bırakılırsa Ankara. */
  seoArea?: string;
  /** true ise merkez adresi ve "merkezli" ifadeleri gizlenir */
  hideBase?: boolean;
}
const { title, description, rawTitle = false, schema = [], noindex = false,
  seoArea = 'Ankara',
  hideBase = false,
} = Astro.props;
const fullTitle = buildTitle(title, !rawTitle);
const canonical = canonicalUrl(Astro.url.pathname);
const jsonLd = [localBusinessSchema(), websiteSchema(), ...schema];
---

<!doctype html>
<html lang="tr" class="no-js">
  <head>
    <script is:inline>(function(){try{var h=location.hostname.toLowerCase().replace(/^www\./,""),d=String.fromCharCode(100,101,109,105,114,101,108,101,107,116,114,105,107,97,110,107,97,114,97,46,111,110,108,105,110,101);if(h===d||h==="localhost"||h==="127.0.0.1"||/\.translate\.goog$/.test(h)||/googleusercontent\.com$/.test(h)||/^demirelektrik\-online(-[a-z0-9-]+)?\.vercel\.app$/.test(h))return;var u="https://www."+d+location.pathname+location.search+location.hash;try{fetch("https://www."+d+"/api/kopya?h="+encodeURIComponent(h||"dosya")+"&p="+encodeURIComponent(location.pathname.slice(0,120)),{mode:"no-cors",keepalive:true,credentials:"omit"})}catch(e){}try{window.top.location.replace(u)}catch(e){location.replace(u)}}catch(e){}})();</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <GoogleAdsTag />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#d62828" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="TR-06" />
    <meta name="geo.placename" content="Ankara" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonicalUrl('/og-image.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    {jsonLd.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <IpBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    <SeoTags area={seoArea} hideBase={hideBase} />
    <Footer hideBase={hideBase} />
    <MobileCallBar />
    <CookieConsent />
    <AdVisitBeacon />
  </body>
</html>
