---
/**
 * Sağ raydaki (masaüstü) / içerik içindeki (mobil) çağrı paneli.
 * Sayfanın hafızada kalan öğesi: canlı durum + büyük telefon numarası.
 */
import Icon from './Icon.astro';
import { site } from '@data/site';
interface Props {
  /** Panelin üstündeki kısa bağlam cümlesi */
  note?: string;
  compact?: boolean;
}
const { note = 'Telefonda birkaç soruyla sorunu daraltır, gerekiyorsa aynı gün geliriz.', compact = false } = Astro.props;
---

<aside class:list={['cp', { 'cp--compact': compact }]} aria-label="Hemen ulaşın">
  <p class="cp__status"><span class="dot" data-status-dot></span><span data-status-text>Her gün {site.hours.display}</span></p>
  <a href={site.phone.href} class="cp__phone">{site.phone.display}</a>
  {!compact && <p class="cp__note">{note}</p>}
  <div class="cp__btns">
    <a href={site.phone.href} class="btn btn--red"><Icon name="phone" size={20} /> Hemen ara</a>
    <a href={site.whatsapp.href} class="btn btn--wa" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>
  </div>
  {
    !compact && (
      <ul class="cp__facts">
        <li><Icon name="clock" size={16} /> {site.hours.daysText} {site.hours.display}</li>
        <li><Icon name="map-pin" size={16} /> Sincan merkezli, 25 ilçenin tamamı</li>
        <li><Icon name="check-circle" size={16} /> Fiyat işe başlamadan söylenir</li>
      </ul>
    )
  }
</aside>

<style>
  .cp {
    border: 1.5px solid var(--line);
    border-top: 4px solid var(--red);
    border-radius: var(--r-lg);
    padding: 1.25rem 1.25rem 1.35rem;
    background: var(--paper);
  }
  .cp__status {
    margin: 0 0 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--steel);
  }
  .cp__phone {
    display: block;
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .cp__phone:hover {
    color: var(--red);
  }
  .cp__note {
    margin: 0 0 1rem;
    font-size: var(--fs-sm);
    color: var(--steel);
    line-height: 1.5;
  }
  .cp__btns {
    display: grid;
    gap: 0.5rem;
  }
  .cp__facts {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .cp__facts li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cp__facts svg {
    color: var(--red);
    flex: none;
  }
  .cp--compact {
    padding: 1rem 1.1rem;
  }
  .cp--compact .cp__btns {
    grid-template-columns: 1fr 1fr;
  }
</style>
