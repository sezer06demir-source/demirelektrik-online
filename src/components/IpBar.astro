---
/** Ziyaretçinin kendi IP'si (middleware /api/ip). Yalnızca isteği yapan kişi görür.
 *  Reklamdan gelen ziyaretçiye (gclid/gbraid/wbraid) gösterilmez: müşteriyi tedirgin edip
 *  Google Ads açılış sayfası deneyimini düşürüyordu. IP kaydı middleware'de yine de yapılır. */
---

<div class="ip" role="note" data-ipbar hidden>
  <div class="container ip__in">
    <span>IP adresiniz <strong data-ip>…</strong><span data-geo hidden></span>. Ziyaretler güvenlik amacıyla kayıt altındadır.</span>
  </div>
</div>

<style>
  .ip {
    background: var(--fog);
    color: var(--steel);
    font-size: 0.72rem;
    line-height: 1.3;
  }
  .ip[hidden] {
    display: none;
  }
  .ip__in {
    padding-block: 0.28rem;
  }
  .ip strong {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  (async () => {
    const bar = document.querySelector<HTMLElement>('[data-ipbar]');
    const ipEl = document.querySelector<HTMLElement>('[data-ip]');
    const geoEl = document.querySelector<HTMLElement>('[data-geo]');
    if (!bar || !ipEl) return;

    // Reklam ziyaretçisi: bu oturum boyunca çubuğu gösterme.
    let fromAd = false;
    try {
      const q = new URLSearchParams(location.search);
      if (q.has('gclid') || q.has('gbraid') || q.has('wbraid')) sessionStorage.setItem('de_ad', '1');
      fromAd = sessionStorage.getItem('de_ad') === '1';
    } catch {
      fromAd = /[?&](gclid|gbraid|wbraid)=/.test(location.search);
    }
    if (fromAd) return;

    bar.hidden = false;
    try {
      let data: { ip?: string | null; countryName?: string | null } | null = null;
      const cached = sessionStorage.getItem('de_ip');
      if (cached) data = JSON.parse(cached);
      if (!data) {
        const res = await fetch('/api/ip', { cache: 'no-store', credentials: 'same-origin' });
        if (!res.ok) throw new Error(String(res.status));
        data = await res.json();
        sessionStorage.setItem('de_ip', JSON.stringify(data));
      }
      ipEl.textContent = data?.ip || 'bilinmiyor';
      if (geoEl && data?.countryName) {
        geoEl.textContent = ` (${data.countryName})`;
        geoEl.hidden = false;
      }
    } catch {
      ipEl.textContent = 'kayıtlı';
    }
  })();
</script>
