---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import CallPanel from '@components/CallPanel.astro';
import StatusScript from '@components/StatusScript.astro';
import RequestForm from '@components/RequestForm.astro';
import { site, situations, promises, stats } from '@data/site';
import { featuredServices } from '@data/services';
import { landingDistricts, allDistricts } from '@data/districts';
import { faqSchema } from '@utils/seo';
import { arrivalShort } from '@utils/tr';

const homeFaq = [
  { q: 'Ne kadar sürede gelirsiniz?', a: 'Sincan ve çevre ilçelerde çoğu zaman bir saat içinde, uzak ilçelerde aynı gün. Aradığınızda o anki yoğunluğa göre net saat veririz.' },
  { q: 'Gelmeden fiyat söyler misiniz?', a: 'Arıza tespitinden sonra ne yapılacağını ve ücretini söyleriz; onay vermeden işe başlamayız. Telefonda çözülen sorunlar için ücret almayız.' },
  { q: 'Akşam saatlerinde de geliyor musunuz?', a: 'Evet, haftanın 7 günü 08:00–23:00 arası çıkıyoruz. Akşam ve hafta sonu çağrılarında varsa fiyat farkını telefonda baştan söyleriz.' },
  { q: 'Sigorta attı, ne yapmalıyım?', a: 'Önce prizlerdeki cihazları çıkarıp sigortayı bir kez kaldırın. Yine atıyorsa kaldırmayı bırakın ve bizi arayın; tekrar tekrar zorlamak kabloyu ısıtır.' },
];
---

<BaseLayout
  title="Ankara Acil Elektrikçi | Aynı Gün Elektrik Arıza Servisi"
  rawTitle
  description={site.description}
  schema={[faqSchema(homeFaq)]}
>
  <StatusScript />

  <section class="hero">
    <div class="container ledger">
      <div>
        <p class="hero__kicker"><span class="dot" data-status-dot></span><span data-status-text>Her gün {site.hours.display}</span></p>
        <h1 class="hero__title">Ankara'da elektrik arızası. Şimdi arayın, aynı gün gelelim.</h1>
        <p class="hero__lead">
          Sigorta atması, elektrik kesintisi, kaçak akım, priz ve pano arızaları için Sincan merkezli acil servis. Telefonda birkaç soruyla
          sorunu daraltırız; gerekiyorsa {site.responseText.toLocaleLowerCase('tr')}.
        </p>
        <a href={site.phone.href} class="hero__phone">{site.phone.display}</a>
        <ul class="hero__stats">
          {stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
        </ul>
      </div>
      <div class="ledger__rail">
        <CallPanel />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sit-title">
    <div class="container">
      <h2 id="sit-title">Şu an ne oluyor?</h2>
      <p class="lead">En sık gelen dört çağrı. Kendinizinkini bulun, gelene kadar ne yapacağınızı okuyun.</p>
      <div class="rows">
        {
          situations.map((s) => (
            <a href={`/hizmetler/${s.slug}`} class="row">
              <span class="row__icon"><Icon name={s.icon} size={22} /></span>
              <span>
                <span class="row__title">{s.title}</span>
                <p class="row__text">{s.text}</p>
              </span>
              <span class="row__go">Ne yapmalı</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--fog" aria-labelledby="svc-title">
    <div class="container">
      <h2 id="svc-title">Baktığımız arızalar</h2>
      <p class="lead">Ev, villa, mağaza ve iş yeri; fabrikada kumanda panoları. İş makinesi ve otomasyon işleri bu serviste yok.</p>
      <ul class="svcgrid">
        {
          featuredServices.map((s) => (
            <li>
              <a href={`/hizmetler/${s.slug}`} class="svc">
                <span class="svc__icon"><Icon name={s.icon} size={22} /></span>
                <span class="svc__title">{s.shortTitle}</span>
                <span class="svc__text">{s.excerpt}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/hizmetler" class="btn btn--line">Tüm arıza türleri</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="prom-title">
    <div class="container ledger">
      <div>
        <h2 id="prom-title">Aradığınızda ne olur</h2>
        <ol class="steps">
          {
            promises.map((p, i) => (
              <li>
                <span class="steps__n">{i + 1}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="more"><a href="/nasil-calisiriz" class="btn btn--line">Süreci ayrıntılı okuyun</a></p>
      </div>
      <div class="ledger__rail">
        <RequestForm />
      </div>
    </div>
  </section>

  <section class="section section--fog" aria-labelledby="area-title">
    <div class="container">
      <h2 id="area-title">Ankara'nın her ilçesine</h2>
      <p class="lead">Merkezimiz Sincan'da. Yakın ilçelere daha hızlı, uzak ilçelere aynı gün. Bölgenizin sayfasında varış süresini görürsünüz.</p>
      <ul class="areas">
        {
          landingDistricts.map((d) => (
            <li>
              <a href={`/hizmet-bolgeleri/${d.slug}`} class="areas__item">
                <span class="areas__name">{d.name}</span>
                <span class="areas__arr">{arrivalShort(d.content.arrival)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="areas__all">
        Diğer ilçeler: {allDistricts.filter((d) => !d.content).map((d) => d.name).join(', ')}. <a href="/hizmet-bolgeleri">Tüm bölgeler</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title">Sık sorulanlar</h2>
      <div class="faq faq--home">
        {
          homeFaq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="more"><a href="/sss" class="btn btn--line">Tüm sorular</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4.5rem) var(--section);
    border-bottom: 1px solid var(--line);
  }
  .hero__kicker {
    margin: 0 0 1rem;
    font-weight: 700;
    color: var(--steel);
    font-size: var(--fs-sm);
  }
  .hero__title {
    font-size: var(--fs-hero);
    max-width: 16ch;
    margin-bottom: 1.25rem;
  }
  .hero__lead {
    font-size: var(--fs-md);
    color: var(--ink-2);
    max-width: 56ch;
    margin-bottom: 1.5rem;
  }
  .hero__phone {
    display: inline-block;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    padding-bottom: 0.2em;
    border-bottom: 6px solid var(--red);
    margin-bottom: 1.75rem;
  }
  .hero__phone:hover {
    color: var(--red);
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
  }
  .hero__stats li {
    display: grid;
    line-height: 1.1;
  }
  .hero__stats strong {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .hero__stats span {
    color: var(--steel);
    font-size: var(--fs-sm);
  }
  @media (max-width: 899px) {
    .hero .ledger__rail {
      display: none;
    }
  }

  .svcgrid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .svcgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .svcgrid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .svc {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem;
    background: var(--paper);
    height: 100%;
  }
  .svc:hover .svc__title {
    color: var(--red);
  }
  .svc__icon {
    color: var(--red);
  }
  .svc__title {
    font-weight: 800;
    font-size: var(--fs-md);
    letter-spacing: -0.01em;
  }
  .svc__text {
    color: var(--steel);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }
  .more {
    margin: 1.5rem 0 0;
  }

  .steps {
    display: grid;
    gap: 1.25rem;
    counter-reset: none;
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .steps__n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-weight: 800;
  }
  .steps h3 {
    margin-bottom: 0.3rem;
  }
  .steps p {
    margin: 0;
    color: var(--ink-2);
  }

  .areas {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .areas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .areas__item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--r);
    background: var(--paper);
  }
  .areas__item:hover {
    border-color: var(--red);
  }
  .areas__name {
    font-weight: 800;
  }
  .areas__arr {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
  }
  .areas__all {
    margin: 1.25rem 0 0;
    color: var(--steel);
    font-size: var(--fs-sm);
    max-width: 80ch;
  }
  .faq--home {
    max-width: 760px;
  }
</style>
