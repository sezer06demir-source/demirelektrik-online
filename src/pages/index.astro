---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import CallPanel from '@components/CallPanel.astro';
import StatusScript from '@components/StatusScript.astro';
import RequestForm from '@components/RequestForm.astro';
import { site, situations, promises, stats, searchTags } from '@data/site';
import { featuredServices } from '@data/services';
import { landingDistricts, allDistricts } from '@data/districts';
import { faqSchema } from '@utils/seo';
import { arrivalShort } from '@utils/tr';

const homeFaq = [
  { q: 'Ne kadar sürede gelirsiniz?', a: 'Sincan ve çevre ilçelerde çoğu zaman bir saat içinde, uzak ilçelerde aynı gün. Aradığınızda o anki yoğunluğa göre net saat veririz.' },
  { q: 'Gelmeden fiyat söyler misiniz?', a: 'Arıza tespitinden sonra ne yapılacağını ve ücretini söyleriz; onay vermeden işe başlamayız. Telefonda çözülen sorunlar için ücret almayız.' },
  { q: 'Akşam saatlerinde de geliyor musunuz?', a: 'Evet, haftanın 7 günü 08:00–23:00 arası çıkıyoruz. Akşam ve hafta sonu çağrılarında varsa fiyat farkını telefonda baştan söyleriz.' },
  { q: 'Sigorta attı, ne yapmalıyım?', a: 'Önce prizlerdeki cihazları çıkarıp sigortayı bir kez kaldırın. Yine atıyorsa kaldırmayı bırakın ve bizi arayın; tekrar tekrar zorlamak kabloyu ısıtır.' },
];
const nearest = landingDistricts.slice(0, 6);
---

<BaseLayout
  title="Ankara Elektrikçi | Acil Elektrik Arıza Servisi | Demir Elektrik"
  rawTitle
  description={site.description}
  schema={[faqSchema(homeFaq)]}
>
  <StatusScript />

  <section class="night hero">
    <div class="container hero__in">
      <div class="hero__main">
        <p class="hero__live"><span class="dot" data-status-dot></span><span data-status-text>Her gün {site.hours.display}</span></p>
        <h1 class="hero__title">Sigorta attı, elektrik gitti. Aynı gün yanınızdayız.</h1>
        <p class="hero__lead">
          Sincan merkezli acil arıza ekibi Ankara'nın 25 ilçesine çıkıyor. Telefonda birkaç soruyla sorunu daraltır, gerekiyorsa hemen
          yola çıkarız.
        </p>
        <a href={site.phone.href} class="hero__phone metric">{site.phone.display}</a>
        <p class="hero__sub">Aramak için dokunun. WhatsApp'tan fotoğraf da gönderebilirsiniz.</p>
        <ul class="hero__stats">
          {stats.map((s) => <li><strong class="metric">{s.value}</strong><span>{s.label}</span></li>)}
        </ul>
      </div>
      <div class="hero__rail"><CallPanel /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="sit-title">
    <div class="container">
      <div class="head">
        <h2 id="sit-title">Şu an ne oluyor?</h2>
        <p class="lead">En sık gelen dört çağrı. Kendinizinkini bulun; biz gelene kadar ne yapacağınız sayfasında yazıyor.</p>
      </div>
      <ul class="sit">
        {
          situations.map((s) => (
            <li>
              <a href={`/hizmetler/${s.slug}`} class="sit__item">
                <span class="sit__icon"><Icon name={s.icon} size={24} /></span>
                <span class="sit__title">{s.title}</span>
                <span class="sit__text">{s.text}</span>
                <span class="sit__go">Ne yapmalı</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--fog" aria-labelledby="svc-title">
    <div class="container">
      <div class="head">
        <h2 id="svc-title">Baktığımız arızalar</h2>
        <p class="lead">Ev, villa, mağaza ve iş yeri; fabrikada kumanda panoları. Şeridin rengi işin aciliyetini gösterir.</p>
      </div>
      <div class="rows rows--white">
        {
          featuredServices.map((s) => (
            <a href={`/hizmetler/${s.slug}`} class="row" data-group={s.group}>
              <span class="row__icon"><Icon name={s.icon} size={22} /></span>
              <span>
                <span class="row__title">{s.title}</span>
                <p class="row__text">{s.excerpt}</p>
              </span>
              <span class="row__go">Ayrıntı</span>
            </a>
          ))
        }
      </div>
      <p class="more"><a href="/hizmetler" class="btn btn--line">Tüm arıza türleri</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="prom-title">
    <div class="container ledger">
      <div>
        <div class="head">
          <h2 id="prom-title">Aradığınızda ne olur</h2>
        </div>
        <ol class="steps">
          {
            promises.map((p, i) => (
              <li>
                <span class="steps__n metric">{i + 1}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="more"><a href="/nasil-calisiriz" class="btn btn--line">Süreci ayrıntılı okuyun</a></p>
      </div>
      <div class="ledger__rail">
        <RequestForm />
      </div>
    </div>
  </section>

  <section class="night arrive" aria-labelledby="area-title">
    <div class="container">
      <div class="head head--night">
        <h2 id="area-title">Nereye, ne kadar sürede</h2>
        <p class="lead">Merkezimiz Sincan'da. Süreler normal trafik içindir; aradığınızda o anki konuma göre net saat veririz.</p>
      </div>
      <ul class="arrive__grid">
        {
          nearest.map((d) => (
            <li>
              <a href={`/hizmet-bolgeleri/${d.slug}`} class="arrive__item">
                <span class="arrive__time metric">{arrivalShort(d.content.arrival)}</span>
                <span class="arrive__name">{d.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="arrive__rest">
        {landingDistricts.slice(6).map((d, i) => (
          <>
            {i > 0 ? ', ' : ''}
            <a href={`/hizmet-bolgeleri/${d.slug}`}>{d.name}</a>
          </>
        ))}
        {' '}ve {allDistricts.filter((d) => !d.content).length} ilçe daha. <a href="/hizmet-bolgeleri" class="arrive__all">Tüm bölgeler ve mahalleler</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container ledger">
      <div>
        <div class="head">
          <h2 id="faq-title">Sık sorulanlar</h2>
        </div>
        <div class="faq">
          {
            homeFaq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
        <p class="more"><a href="/sss" class="btn btn--line">Tüm sorular</a></p>
      </div>
      <div class="ledger__rail">
        <nav class="tagbox" aria-labelledby="tag-title">
          <h2 id="tag-title" class="tagbox__title">Ne arıyorsunuz?</h2>
          <ul class="tags">
            {searchTags.map((t) => <li><a class="tag" href={t.href}>{t.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- hero --- */
  .hero {
    padding-block: clamp(2.25rem, 5vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  /* Pano ray deseni: ince dikey çizgiler, sağ üstte sönümlenir */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 64px);
    mask-image: radial-gradient(120% 90% at 100% 0%, #000 20%, transparent 72%);
  }
  .hero__in {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .hero__in {
      grid-template-columns: minmax(0, 1fr) var(--rail);
      align-items: start;
    }
  }
  .hero__live {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0 0 1.25rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--night-line);
    background: var(--night-2);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--on-night);
  }
  .hero__title {
    font-size: var(--fs-hero);
    max-width: 18ch;
    margin-bottom: 1.1rem;
  }
  .hero__lead {
    font-size: var(--fs-md);
    color: var(--on-night);
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }
  .hero__phone {
    display: inline-block;
    font-size: clamp(2.1rem, 1.1rem + 4.2vw, 3.9rem);
    color: #fff;
    padding-bottom: 0.15em;
    border-bottom: 5px solid var(--red);
  }
  .hero__phone:hover {
    color: var(--red);
    border-color: #fff;
  }
  .hero__sub {
    margin: 0.75rem 0 2rem;
    font-size: var(--fs-sm);
    color: var(--on-night-dim);
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-line);
  }
  .hero__stats li {
    display: grid;
    gap: 0.15rem;
  }
  .hero__stats strong {
    font-size: 1.7rem;
    color: #fff;
  }
  .hero__stats span {
    color: var(--on-night-dim);
    font-size: var(--fs-sm);
  }
  @media (max-width: 899px) {
    .hero__rail {
      display: none;
    }
  }

  /* --- bölüm başlıkları --- */
  .head {
    margin-bottom: 1.75rem;
    max-width: 62ch;
  }
  .head .lead {
    margin: 0.6rem 0 0;
  }
  .head--night .lead {
    color: var(--on-night-dim);
  }

  /* --- durum kartları --- */
  .sit {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .sit {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .sit__item {
    display: grid;
    gap: 0.45rem;
    height: 100%;
    padding: 1.35rem 1.4rem 1.5rem;
    background: var(--paper);
    border-top: 3px solid transparent;
    transition: border-color var(--dur), background-color var(--dur);
  }
  .sit__item:hover {
    border-top-color: var(--red);
    background: #fff;
  }
  .sit__icon {
    color: var(--red);
  }
  .sit__title {
    font-weight: 800;
    font-size: var(--fs-md);
    letter-spacing: -0.015em;
  }
  .sit__text {
    color: var(--steel);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .sit__go {
    margin-top: 0.35rem;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--red);
  }

  .rows--white .row {
    background: var(--paper);
    padding-inline: 1rem;
    border-bottom-color: var(--line);
  }
  .rows--white {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .rows--white .row:last-child {
    border-bottom: 0;
  }
  .more {
    margin: 1.5rem 0 0;
  }

  /* --- adımlar --- */
  .steps {
    display: grid;
    gap: 1.25rem;
  }
  .steps li {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .steps li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .steps__n {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-size: 1.1rem;
  }
  .steps h3 {
    margin-bottom: 0.3rem;
  }
  .steps p {
    margin: 0;
    color: var(--ink-2);
  }

  /* --- varış süreleri --- */
  .arrive {
    padding-block: var(--section);
  }
  .arrive__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 700px) {
    .arrive__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .arrive__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .arrive__item {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1rem 1.1rem;
    border: 1px solid var(--night-line);
    border-radius: var(--r);
    background: var(--night-2);
    transition: border-color var(--dur), background-color var(--dur);
  }
  .arrive__item:hover {
    border-color: var(--green);
    background: #1d2230;
  }
  .arrive__time {
    font-size: 1.5rem;
    color: var(--green);
  }
  .arrive__name {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--on-night);
  }
  .arrive__rest {
    margin: 1.5rem 0 0;
    color: var(--on-night-dim);
    font-size: var(--fs-sm);
    max-width: 80ch;
  }
  .arrive__rest a {
    color: var(--on-night);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }
  .arrive__rest a:hover {
    color: #fff;
    text-decoration-color: var(--red);
  }
  .arrive__all {
    font-weight: 700;
  }

  /* --- arama etiketleri --- */
  .tagbox {
    border: 1.5px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.25rem;
  }
  .tagbox__title {
    font-size: var(--fs-base);
    margin-bottom: 0.85rem;
  }
</style>
