---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import CallPanel from '@components/CallPanel.astro';
import PageHead from '@components/PageHead.astro';
import StatusScript from '@components/StatusScript.astro';
import RequestForm from '@components/RequestForm.astro';
import { site } from '@data/site';
import { getDistrict } from '@data/districts';
import { neighborhoods, getNeighborhoodsOf, type Neighborhood } from '@data/neighborhoods';
import { getService } from '@data/services';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@utils/seo';
import { locative, arrivalShort } from '@utils/tr';

export function getStaticPaths() {
  return neighborhoods.map((n) => ({ params: { district: n.districtSlug, slug: n.slug }, props: { hood: n } }));
}
interface Props {
  hood: Neighborhood;
}
const { hood: n } = Astro.props;
const c = n.content;
const d = getDistrict(n.districtSlug);
if (!d) throw new Error(`İlçe bulunamadı: ${n.districtSlug}`);
const dPath = `/hizmet-bolgeleri/${d.slug}`;
const path = `${dPath}/${n.slug}`;
const inH = locative(n.name, n.locative);
const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Bölgeler', href: '/hizmet-bolgeleri' },
  { name: d.name, href: dPath },
  { name: n.name, href: path },
];
const svc = c.highlightedServices.map(getService).filter((s): s is NonNullable<typeof s> => Boolean(s));
const siblings = getNeighborhoodsOf(d.slug).filter((x) => x.slug !== n.slug);
---

<BaseLayout title={c.seoTitle} rawTitle seoArea={n.name} description={c.seoDescription} schema={[breadcrumbSchema(crumbs), serviceSchema({ name: `${n.name} Acil Elektrikçi`, description: c.seoDescription, path, areaName: `${n.name}, ${d.name}` }), faqSchema(c.faq)]}>
  <StatusScript />
  <PageHead
    crumbs={crumbs}
    title={c.h1}
    eyebrow={`${d.name}, Ankara`}
    lead={c.subtitle}
    chips={[
      { icon: 'navigation', text: `Varış ${arrivalShort(c.arrival)}`, go: true },
      { icon: 'clock', text: `${site.hours.daysText} ${site.hours.display}` },
      { icon: 'phone', text: site.phone.display },
    ]}
  />
  <article class="section">
    <div class="container ledger">
      <div>
        <p class="arrive"><Icon name="navigation" size={18} /> {c.arrival}</p>
        <div class="prose">{c.intro.map((p) => <p>{p}</p>)}</div>

        <section aria-labelledby="s1">
          <h2 id="s1" class="h">{inH} en çok gelen çağrılar</h2>
          <div class="rows">
            {svc.map((s) => (
              <a href={`/hizmetler/${s.slug}`} class="row" data-group={s.group}>
                <span class="row__icon"><Icon name={s.icon} size={22} /></span>
                <span><span class="row__title">{s.title}</span><p class="row__text">{s.excerpt}</p></span>
                <span class="row__go">Ayrıntı</span>
              </a>
            ))}
          </div>
        </section>

        <section aria-labelledby="s2">
          <h2 id="s2" class="h">{inH} bildiklerimiz</h2>
          <ul class="notes">{c.localNotes.map((x) => <li><h3>{x.title}</h3><p>{x.text}</p></li>)}</ul>
        </section>

        <section aria-labelledby="s3">
          <h2 id="s3" class="h">{inH} gittiğimiz noktalar</h2>
          <ul class="tags">{c.landmarks.map((l) => <li><span class="tag tag--muted">{l}</span></li>)}</ul>
        </section>

        <section aria-labelledby="s4">
          <h2 id="s4" class="h">Sorular</h2>
          <div class="faq">{c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
        </section>

        <section class="form"><RequestForm title={`${inH} arıza bildirin`} presetDistrict={d.type === 'semt' ? d.parent : d.name} /></section>

        <section aria-labelledby="s5">
          <h2 id="s5" class="h">{locative(d.name, d.locative)} diğer mahalleler</h2>
          <ul class="tags">
            {siblings.map((s) => <li><a class="tag" href={`${dPath}/${s.slug}`}>{s.name}</a></li>)}
            <li><a class="tag tag--muted" href={dPath}>{d.name} sayfası</a></li>
          </ul>
        </section>
      </div>
      <div class="ledger__rail"><CallPanel note={`${inH} elektrik arızası için arayın; ${c.arrival.toLocaleLowerCase('tr')}.`} /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .arrive {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-left: 4px solid var(--green);
    border-radius: 0 var(--r) var(--r) 0;
    background: var(--green-tint);
    color: #14532d;
    font-weight: 600;
    font-size: var(--fs-sm);
    margin: 0 0 1.75rem;
    max-width: 62ch;
  }
  .arrive svg {
    flex: none;
    margin-top: 3px;
  }
  .h {
    font-size: var(--fs-lg);
    margin: 2.25rem 0 0.75rem;
  }
  .notes {
    display: grid;
    gap: 1rem;
  }
  .notes li {
    border-left: 4px solid var(--red);
    padding-left: 1rem;
  }
  .notes h3 {
    font-size: var(--fs-base);
    margin-bottom: 0.25rem;
  }
  .notes p {
    margin: 0;
    color: var(--ink-2);
  }
  .form {
    margin-top: 2.5rem;
  }
</style>
