---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import CallPanel from '@components/CallPanel.astro';
import PageHead from '@components/PageHead.astro';
import StatusScript from '@components/StatusScript.astro';
import { servicesByGroup, services } from '@data/services';
import { site, searchTags } from '@data/site';
import { breadcrumbSchema } from '@utils/seo';
const crumbs = [
  { name: 'Ana sayfa', href: '/' },
  { name: 'Arıza türleri', href: '/hizmetler' },
];
---

<BaseLayout
  title="Arıza Türleri | Ankara Acil Elektrik Servisi | Demir Elektrik"
  rawTitle
  description="Sigorta atması, elektrik kesintisi, kaçak akım, priz ve pano arızaları, avize montajı, ev, villa, iş yeri ve fabrika kumanda panoları. Ankara'da aynı gün servis: 0506 092 58 16."
  schema={[breadcrumbSchema(crumbs)]}
>
  <StatusScript />
  <PageHead
    crumbs={crumbs}
    title="Baktığımız arızalar"
    eyebrow="Ankara acil elektrik servisi"
    eyebrowIcon="zap"
    lead="Belirtinizi bulun; her sayfada biz gelene kadar ne yapacağınız yazıyor. Listede yoksa arayın, telefonda yönlendirelim."
    chips={[
      { icon: 'layers', text: `${services.length} arıza türü` },
      { icon: 'clock', text: `${site.hours.daysText} ${site.hours.display}` },
      { icon: 'phone', text: site.phone.display },
    ]}
  />
  <section class="section">
    <div class="container ledger">
      <div>
        {
          servicesByGroup().map((g) => (
            <section class="grp" aria-labelledby={`g-${g.group}`}>
              <h2 id={`g-${g.group}`} class="grp__title">
                <span class="grp__dot" data-group={g.group} aria-hidden="true"></span>
                {g.label}
              </h2>
              <div class="rows">
                {g.items.map((s) => (
                  <a href={`/hizmetler/${s.slug}`} class="row" data-group={s.group}>
                    <span class="row__icon"><Icon name={s.icon} size={22} /></span>
                    <span>
                      <span class="row__title">{s.title}</span>
                      <p class="row__text">{s.excerpt}</p>
                    </span>
                    <span class="row__go">Ayrıntı</span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
        <section class="grp" aria-labelledby="tag-title">
          <h2 id="tag-title" class="grp__title">Aramada sık yazılanlar</h2>
          <ul class="tags">{searchTags.map((t) => <li><a class="tag" href={t.href}>{t.label}</a></li>)}</ul>
        </section>
      </div>
      <div class="ledger__rail"><CallPanel /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .grp {
    margin-top: 2.5rem;
  }
  .grp:first-child {
    margin-top: 0;
  }
  .grp__title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--fs-lg);
    margin-bottom: 0.75rem;
  }
  .grp__dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--line);
  }
  .grp__dot[data-group='acil'] {
    background: var(--red);
  }
  .grp__dot[data-group='tamir'] {
    background: var(--amber);
  }
  .grp__dot[data-group='kurulum'] {
    background: var(--steel);
  }
</style>
